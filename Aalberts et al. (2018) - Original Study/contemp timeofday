######################################
# 2b. Time-of-day moderation analysis #
######################################

# Parse time and create early/late split
dataset$hour <- as.integer(substr(dataset$Time, 1, 2))
table(dataset$hour) 

# Binary split: early (10-16) vs late (18-22)
dataset$time_block <- ifelse(dataset$hour <= 17, "early", "late") ##data had a response window of 2 hours
dataset$time_block <- factor(dataset$time_block, levels = c("early", "late"))

# check
table(dataset$time_block)
table(dataset$time_block, dataset$hour)

#### create contemporaneous networks to look at effects of late vs early
dataset_early <- subset(dataset, time_block == "early")
dataset_late  <- subset(dataset, time_block == "late")

network_early <- mlVAR(data = dataset_early,
                            vars = colnames(dataset)[c(15:23, 26)],
                            idvar = "Participant",
                            dayvar = "Date",
                            beepvar = "Notification.No")  

network_late  <- mlVAR(data = dataset_late,
                            vars = colnames(dataset)[c(15:23, 26)],
                            idvar = "Participant",
                            dayvar = "Date",
                            beepvar = "Notification.No")

### create plots and save visualization
e1 <- plot(network_early, "contemporaneous", layout = "spring", rule = "and",
           nonsig = "hide", groups = groups, legend = FALSE)
l1 <- plot(network_late,  "contemporaneous", layout = "spring", rule = "and",
           nonsig = "hide", groups = groups, legend = FALSE)

L_mod <- averageLayout(e1, l1)

pdf("Figure_Moderation_Contemporaneous.pdf", height = 5, width = 25)
layout(matrix(1:2, 1, 2))
qgraph(e1, layout = L_mod, title = "Early (10:00-16:00)",
       groups = groups, labels = labels, nodeNames = names,
       vsize = 7, esize = 4, legend = TRUE, legend.mode = "names",
       legend.cex = 0.5,
       color = c(rep("red",7), "dodgerblue", rep("green",2)))

qgraph(l1, layout = L_mod, title = "Late (18:00-22:00)",
       groups = groups, labels = labels, nodeNames = names,
       vsize = 7, esize = 4, legend = TRUE, legend.mode = "names",
       legend.cex = 0.5,
       color = c(rep("red",7), "dodgerblue", rep("green",2)))
dev.off()

###compute edge weights to compare numerically
e1_wmat <- getWmat(e1) 
l1_wmat <- getWmat(l1)
diff_contemp  <- l1_wmat - e1_wmat ###look at

l1_wmat[,9:10]
e1_wmat[,9:10]
diff_contemp[, 9:10] 
