                             out, pred, rhs_covars)
  
  m_full <- tryCatch(
    lmerTest::lmer(as.formula(formula_full), data = d_sub, REML = FALSE,
                   control = lme4::lmerControl(optimizer = "bobyqa")),
    error = function(e) NULL, warning = function(w) NULL)
